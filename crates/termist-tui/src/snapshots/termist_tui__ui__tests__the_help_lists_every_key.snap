" termist   orbit-api ◆1✓1                                                 12:00 "
"┏┌ help ──────────────────────────────────────────────────────────────────────┐ "
"┃│termist <version> · default settings │ "
"┃│                                                                            │ "
"┗│Grid                                                                        │ "
"┌│  p            new task: prompt, CLI, model                                 │┐"
"││  Space        send the next instruction without entering                   ││"
"││  Enter        type into the selected session                               ││"
"││  /            find a session                                               ││"
"││  .            next session that needs you                                  ││"
"││  ,            previous session that needs you                              ││"
"││  n            new agent session                                            ││"
"││  t            new shell                                                    ││"
"││  P            new task like the card, in its worktree                      ││"
"││  W            the worktrees: show, hide, remove                            ││"
"││  X            remove the worktree; the branch stays                        ││"
"││  g            what the card's branch changed, file by file                 ││"
"││  e            your agent setups: CLI, model, words (^S saves one)          ││"
"││  L            lazygit in the card's folder, as a card                      ││"
"││  O            the card's folder in your editor                             ││"
"││  f            a file of the repo, opened in your editor                    ││"
"││  F            lines with some text (git grep), opened at the line          ││"
"││  h            card to the left                                             ││"
"││  j            card below                                                   ││"
"││  k            card above                                                   ││"
"││  l            card to the right                                            ││"
"││  C-d          half a page down                                             ││"
"││  C-u          half a page up                                               ││"
"││  PageUp       scroll back through the session's output                     ││"
"││  ]            next project tab                                             ││"
"││  [            previous project tab                                         ││"
"││  1-9          project tab 1 to 9                                           ││"
"││  o            open a project                                               ││"
"││  x            close the project tab                                        ││"
"││  r            rename the card                                              ││"
"││  a            archive the card                                             ││"
"││  A            show archived cards                                          ││"
"││  v            the project's pull requests                                  ││"
"└└────────────────────────────────────────────────────────────────────────────┘┘"
"j/k scroll · Esc close                                                          "
