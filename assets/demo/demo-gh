]


def counts(text):
    plus = sum(1 for l in text.splitlines() if l.startswith("+"))
    minus = sum(1 for l in text.splitlines() if l.startswith("-"))
    return plus, minus


def rest_files(files):
    out = []
    for path, status, old, new in files:
        p = patch(old, new)
        plus, minus = counts(p)
        out.append({"filename": path, "status": status, "additions": plus,
                    "deletions": minus, "changes": plus + minus, "patch": p})
    return out


def line_of(text, part):
    return next(i for i, l in enumerate(text.splitlines(), 1) if part in l)


def hunk_to(path, line):
    """GitHub's diffHunk for a comment on new line `line` of `path`: its hunk, cut there."""
    for p, _, old, new in FILES_212:
        if p != path:
            continue
        out, n = [], 0
        for l in patch(old, new).splitlines():
            if l.startswith("@@"):
                out = [l]
                n = int(re.search(r"\+(\d+)", l).group(1)) - 1
                continue
            out.append(l)
            if not l.startswith("-"):
                n += 1
            if n == line:
                return "\n".join(out)
    return ""


