def comment(cid, who, body, hours, mine=False, hunk=None):
    c = {"id": cid, "author": {"login": who}, "body": body, "createdAt": ago(hours=hours),
         "viewerDidAuthor": mine, "viewerCanUpdate": mine, "viewerCanDelete": mine}
    if hunk is not None:
        c["diffHunk"] = hunk
    return c


def check(name, workflow, conclusion="SUCCESS", minutes=40, took=(1, 12)):
    status = "COMPLETED" if conclusion else "IN_PROGRESS"
    return {"__typename": "CheckRun", "name": name, "status": status, "conclusion": conclusion,
            "detailsUrl": "https://github.com/acme/site/actions/runs/1",
            "startedAt": ago(minutes=minutes),
            "completedAt": ago(minutes=minutes - took[0], seconds=-took[1]) if conclusion else None,
            "checkSuite": {"workflowRun": {"workflow": {"name": workflow}}}}


