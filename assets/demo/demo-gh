        return {"data": {"viewer": {"login": VIEWER}, "repository": {"pullRequest": None}}}
    p = dict(summary)
    p.update({"id": f"PR_{number}", "headRefOid": "9f3c2a1e7b5d4c6a8e0f1b2c3d4e5f6a7b8c9d0e",
              "viewerDidAuthor": False, "pending": {"nodes": []}})
    if repo == "acme/site" and number == 212:
        p["body"] = (
            "Signing in from a page you were sent away from took you to the login page again, "
            "forever: `return_to` was read after the session was cleared.\n\n"
            "Now the redirect is built first, and the session gets a new id instead of being "
            "cleared. Only addresses on this site are returned to.\n\nCloses #188.")
        p["comments"] = {"totalCount": 2, "nodes": [
            comment("IC_1", "bob", "Repro before: sign out, open /settings/billing, sign in. "
