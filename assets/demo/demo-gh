def patch(old, new):
    lines = difflib.unified_diff(old.splitlines(), new.splitlines(), lineterm="", n=3)
    return "\n".join(list(lines)[2:])


FILES_212 = [
    ("src/auth/redirect.rs", "modified", REDIRECT_OLD, REDIRECT_NEW),
    ("src/auth/session.rs", "modified", SESSION_OLD, SESSION_NEW),
