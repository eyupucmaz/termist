def files_of(repo, number):
    if repo == "acme/site" and number == 212:
        return f212
    return rest_files([("README.md", "modified", "# site\n", "# site\n\nA demo.\n")])


def repos_asked(query):
    return re.findall(r'(r\d+): repository\(owner: "([^"]+)", name: "([^"]+)"\)', query)


def written(p, state):
    """What you wrote, in the pull request as GitHub would show it."""
    def mine(c, pending=False):
        out = comment(c["id"], VIEWER, c["body"], 0, mine=True)
        out["createdAt"] = c["at"]
        if pending:
            out["state"] = "PENDING"
        return out
    p["comments"]["nodes"] += [mine(c) for c in state["comments"]]
    p["reviews"]["nodes"] += [
        {"author": {"login": VIEWER}, "state": r["state"], "body": r["body"], "submittedAt": r["at"]}
        for r in state["reviews"]]
    for t in state["threads"]:
        hunk = hunk_to(t["path"], t["line"])
        first = dict(mine(t, t["pending"]), diffHunk=hunk)
        p["reviewThreads"]["nodes"].append({
            "id": t["id"], "isResolved": False, "isOutdated": False, "path": t["path"],
            "line": t["line"], "originalLine": t["line"], "startLine": t["start"],
            "diffSide": t["side"], "viewerCanReply": True, "viewerCanResolve": True,
            "viewerCanUnresolve": False, "comments": {"totalCount": 1, "nodes": [first]}})
    for t in p["reviewThreads"]["nodes"]:
        replies = [dict(mine(c), diffHunk="") for c in state["replies"].get(t["id"], [])]
        t["comments"]["nodes"] += replies
        t["comments"]["totalCount"] += len(replies)
        if t["id"] in state["resolved"]:
            t.update(isResolved=True, viewerCanUnresolve=True)
    p["comments"]["totalCount"] = len(p["comments"]["nodes"])
    p["reviews"]["totalCount"] = len(p["reviews"]["nodes"])
    p["reviewThreads"]["totalCount"] = len(p["reviewThreads"]["nodes"])
    if any(t["pending"] for t in state["threads"]):
        p["pending"] = {"nodes": [{"id": "PRR_demo"}]}


def arg(query, key):
    m = re.search(key + r': ("(?:[^"\\]|\\.)*"|\d+|[A-Z_]+)', query)
    if not m:
        return None
    v = m.group(1)
    return json.loads(v) if v.startswith('"') else int(v) if v.isdigit() else v


def write(query):
    field = re.search(r"mutation \{ (\w+)", query).group(1)
    state = load()
    at = ago(seconds=0)
    n = sum(len(v) if isinstance(v, list) else 1 for v in state.values())
    if field == "addComment":
        state["comments"].append({"id": f"IC_d{n}", "body": arg(query, "body"), "at": at})
    elif field == "addPullRequestReviewThread":
        state["threads"].append({
            "id": f"T_d{n}", "body": arg(query, "body"), "at": at, "path": arg(query, "path"),
            "line": arg(query, "line"), "start": arg(query, "startLine"),
            "side": arg(query, "side") or "RIGHT", "pending": True})
    elif field == "addPullRequestReviewThreadReply":
        thread = arg(query, "pullRequestReviewThreadId")
        state["replies"].setdefault(thread, []).append(
            {"id": f"RC_d{n}", "body": arg(query, "body"), "at": at})
    elif field in ("resolveReviewThread", "unresolveReviewThread"):
        thread = arg(query, "threadId")
        state["resolved"] = [t for t in state["resolved"] if t != thread]
        if field == "resolveReviewThread":
            state["resolved"].append(thread)
    elif field in ("submitPullRequestReview", "addPullRequestReview"):
        event = arg(query, "event")
        state["reviews"].append({
            "state": {"APPROVE": "APPROVED", "REQUEST_CHANGES": "CHANGES_REQUESTED"}.get(
                event, "COMMENTED"),
            "body": arg(query, "body") or "", "at": at})
        for t in state["threads"]:
            t["pending"] = False
    save(state)
    return {"data": {field: {"clientMutationId": None}}}


def graphql(query):
    one = re.search(r'repository\(owner: "([^"]+)", name: "([^"]+)"\) \{\s*pullRequest\(number: (\d+)\)',
                    query)
    if query.lstrip().startswith("mutation"):
        return write(query)
    if "viewerPermission" in query:
        return {"data": {a: {"viewerPermission": "WRITE"} for a, o, n in repos_asked(query)}}
    if "reviewThreads" in query:
        return detail(f"{one.group(1)}/{one.group(2)}", int(one.group(3)))
    if "pageInfo" in query:
        repo, number = f"{one.group(1)}/{one.group(2)}", int(one.group(3))
        nodes = [{"path": f["filename"],
                  "viewerViewedState": "VIEWED" if f["filename"] == "CHANGELOG.md" else "UNVIEWED"}
                 for f in files_of(repo, number)]
        return {"data": {"repository": {"pullRequest": {"files": {
            "pageInfo": {"hasNextPage": False, "endCursor": None}, "nodes": nodes}}}}}
    if "states: PENDING" in query:
        pending = [{"id": "PRR_demo"}] if any(t["pending"] for t in load()["threads"]) else []
        return {"data": {"repository": {"pullRequest": {"reviews": {"nodes": pending}}}}}
    data = {"viewer": {"login": VIEWER},
            "rateLimit": {"remaining": 4980, "resetAt": ago(minutes=-40)}}
    for alias, owner, name in repos_asked(query):
        prs = PRS.get(f"{owner}/{name}")
        if prs is None:
            data[alias] = None
        elif "first: 50" in query:
            data[alias] = {"pullRequests": {"totalCount": len(prs), "nodes": prs}}
        else:
            data[alias] = {"pullRequests": {"totalCount": len(prs)}}
    return {"data": data}


def main():
    args = sys.argv[1:]
    if args[:2] == ["auth", "status"]:
        print(json.dumps({"hosts": {"github.com": [
            {"login": VIEWER, "active": True, "state": "success"}]}}))
    elif args[:2] == ["auth", "token"]:
        print("demo-token")
    elif args[:2] == ["api", "graphql"]:
        query = json.loads(sys.stdin.read() or "{}").get("query", "")
        print(json.dumps(graphql(query)))
    elif args[:1] == ["api"]:
        m = re.search(r"repos/([^/]+)/([^/]+)/pulls/(\d+)/files\?.*page=(\d+)", args[-1])
        if not m:
            sys.exit(1)
        repo, number, page = f"{m.group(1)}/{m.group(2)}", int(m.group(3)), int(m.group(4))
        print(json.dumps(files_of(repo, number) if page == 1 else []))
    elif args[:2] == ["pr", "checkout"]:
        number, repo = int(args[2]), args[args.index("-R") + 1]
        head = next(p["headRefName"] for p in PRS[repo] if p["number"] == number)
        sys.exit(subprocess.run(["git", "checkout", "-q", "-b", head]).returncode)
    else:
        print(f"demo gh: unknown command {' '.join(args)}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
