def pr(repo, number, title, author, head, plus, minus, files, *, draft=False, hours=1,
       mergeable="MERGEABLE", decision="REVIEW_REQUIRED", requested=(), verdicts=(),
       checks="SUCCESS"):
    return {
        "number": number, "title": title, "url": f"https://github.com/{repo}/pull/{number}",
        "isDraft": draft, "state": "OPEN", "createdAt": ago(hours=hours + 30),
        "updatedAt": ago(hours=hours), "headRefName": head,
        "headRepository": {"nameWithOwner": repo}, "baseRefName": "main",
        "additions": plus, "deletions": minus, "changedFiles": files,
        "mergeable": mergeable, "reviewDecision": decision, "author": {"login": author},
        "reviewRequests": {"nodes": [
            {"requestedReviewer": {"__typename": "User", "login": r}} for r in requested]},
        "latestOpinionatedReviews": {"nodes": [
            {"state": s, "author": {"login": who}} for who, s in verdicts]},
        "commits": {"nodes": [{"commit": {"statusCheckRollup": checks and {"state": checks}}}]},
    }


