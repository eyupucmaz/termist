SESSION_NEW = """\
use std::time::{Duration, SystemTime};

/// How long a session lives without a request.
pub const IDLE: Duration = Duration::from_secs(30 * 60);

pub struct Session {
    pub id: SessionId,
    pub user: Option<UserId>,
    pub return_to: Option<String>,
    pub expires: SystemTime,
}

impl Session {
    /// Signs the user out and forgets everything about them.
    pub fn clear(&mut self) {
        self.user = None;
        self.return_to = None;
        self.id = SessionId::random();
    }

    /// A new id for the same session, as after a sign-in:
    /// what it holds stays, an old id stops working.
    pub fn rotate(&mut self) {
        self.id = SessionId::random();
        self.expires = SystemTime::now() + IDLE;
    }

    pub fn is_expired(&self) -> bool {
        SystemTime::now() > self.expires
    }
}
"""

