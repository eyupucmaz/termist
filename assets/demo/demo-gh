#!/usr/bin/env python3
"""A stand-in GitHub CLI for recording termist's pull request screens.

termist's daemon runs it as `gh` (TERMIST_GH_BIN). It answers the few commands termist
uses, `auth status`, `auth token`, `api graphql` and the REST files list, and
`pr checkout` in a worktree, with made-up data: the repos acme/site and acme/api, the
people alice, bob, carol and deniz (who is "you"). What you write to acme/site#212 is
kept in $TERMIST_HOME/demo-gh.json, so it shows up as it would on GitHub. It never
touches the network.
"""
import datetime
import difflib
import json
import os
import re
import subprocess
import sys

VIEWER = "deniz"
NOW = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)
STATE = os.path.join(os.environ.get("TERMIST_HOME", "/tmp"), "demo-gh.json")


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"comments": [], "threads": [], "replies": {}, "resolved": [], "reviews": []}


def save(state):
    with open(STATE, "w") as f:
        json.dump(state, f)


def ago(**delta):
    return (NOW - datetime.timedelta(**delta)).strftime("%Y-%m-%dT%H:%M:%SZ")


