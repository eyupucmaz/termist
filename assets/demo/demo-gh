REDIRECT_NEW = """\
use crate::auth::session::Session;
use crate::auth::url::same_origin;
use axum::http::Uri;

/// Where to send you after you sign in: `asked` is the page
/// the login page stopped you on, if any.
pub fn return_to(s: &mut Session, asked: Option<&Uri>) -> Uri {
    let target = match asked {
        Some(u) if same_origin(u) && !is_login(u) => u.clone(),
        _ => Uri::from_static("/"),
    };
    // Build the redirect first: clearing the session dropped
    // `return_to`, and login sent you back to itself.
    let redirect = target.clone();
    s.rotate();
    redirect
}

fn is_login(uri: &Uri) -> bool {
    uri.path().trim_end_matches('/') == "/login"
}

/// The login page's own address, with where to go next.
pub fn login_url(next: &Uri) -> String {
    format!("/login?next={}", urlencoding::encode(&next.to_string()))
}
"""

